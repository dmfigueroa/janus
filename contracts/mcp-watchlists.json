  "cases": [
    {
      "id": "list-watchlists-paginated-sort",
      "description": "list_watchlists supports orderBy/order and cursor continuation",
      "mutating": false,
      "steps": [
        {
          "tool": "list_watchlists",
          "arguments": { "orderBy": "createdAt", "order": "asc", "pageSize": 2 },
          "expect": { "kind": "ok", "hasCursor": true }
        },
        {
          "tool": "list_watchlists",
          "arguments": {
            "orderBy": "createdAt",
            "order": "asc",
            "pageSize": 2,
            "cursor": "$prev.nextCursor"
          },
          "expect": { "kind": "ok", "hasCursor": false }
        }
      ]
    },
    {
      "id": "list-watchlists-last-watched-and-added",
      "description": "list_watchlists orders by lastWatched and lastAdded consistently",
      "mutating": false,
      "steps": [
        {
          "tool": "list_watchlists",
          "arguments": { "orderBy": "lastWatched", "order": "desc" },
          "expect": { "kind": "ok", "hasCursor": false }
        },
        {
          "tool": "list_watchlists",
          "arguments": { "orderBy": "lastAdded", "order": "desc" },
          "expect": { "kind": "ok", "hasCursor": false }
        }
      ]
    },
    {
      "id": "search-watchlists-unicode-folding",
      "description": "search_watchlists matches NFC-decomposed accents and Greek case folding",
      "mutating": false,
      "steps": [
        {
          "tool": "search_watchlists",
          "arguments": { "query": "CAFE\u0301" },
          "expect": { "kind": "ok", "hasCursor": false }
        },
        {
          "tool": "search_watchlists",
          "arguments": { "query": "ος" },
          "expect": { "kind": "ok", "hasCursor": false }
        }
      ]
    },
    {
      "id": "get-watchlist-items-pagination-and-order-token",
      "description": "get_watchlist returns exact orderToken and paginates items with bound cursors",
      "mutating": false,
      "steps": [
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": 41, "pageSize": 1 },
          "expect": { "kind": "ok", "hasCursor": true, "hasOrderToken": true }
        },
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": 41, "pageSize": 1, "cursor": "$prev.nextCursor" },
          "expect": { "kind": "ok", "hasCursor": true, "hasOrderToken": true }
        },
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": 41, "pageSize": 2, "cursor": "$prev.nextCursor" },
          "expect": { "kind": "toolError" }
        }
      ]
    },
    {
      "id": "get-watchlist-titles-view",
      "description": "get_watchlist titles view collapses episodes under shared parentId",
      "mutating": false,
      "steps": [
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": 41, "resultView": "titles" },
          "expect": { "kind": "ok", "hasCursor": false, "hasOrderToken": false }
        }
      ]
    },
    {
      "id": "get-watchlist-coercion-characterization",
      "description": "get_watchlist coerces watchlistId string/hex/single-array forms and strips unknown keys",
      "mutating": false,
      "steps": [
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": "41.0", "pageSize": 1 },
          "expect": { "kind": "ok", "hasCursor": true, "hasOrderToken": true }
        },
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": "0x29", "pageSize": 1, "ignored": 123 },
          "expect": { "kind": "ok", "hasCursor": true, "hasOrderToken": true }
        },
        {
          "tool": "get_watchlist",
          "arguments": { "watchlistId": ["41"], "pageSize": 1 },
          "expect": { "kind": "ok", "hasCursor": true, "hasOrderToken": true }
        }
      ]
    },
    {
      "id": "get-watchlist-missing-error",
