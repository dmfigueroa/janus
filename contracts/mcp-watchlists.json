{
  "version": 1,
  "tools": {
    "ported": [
      {
        "name": "list_watchlists",
        "title": "List watchlists",
        "description": "List watchlist summaries using Janus's supported sort order.",
        "annotations": { "readOnlyHint": true, "destructiveHint": false }
      },
      {
        "name": "search_watchlists",
        "title": "Search watchlists",
        "description": "Find watchlist summaries by a case-insensitive partial name.",
        "annotations": { "readOnlyHint": true, "destructiveHint": false }
      },
      {
        "name": "get_watchlist",
        "title": "Get watchlist",
        "description": "Get one watchlist with summary counts and a cursor-paginated result page. Use resultView: \"items\" | \"titles\" to choose individual entries or titles that group all episodes from the same TV show and issues from the same series.",
        "annotations": { "readOnlyHint": true, "destructiveHint": false }
      },
      {
        "name": "find_watchlist_items",
        "title": "Find watchlist items",
        "description": "Find watchlist items by a Janus watchlist item ID; explicit provider, provider ID, and media type; or case-insensitive title, parent-title, and episode text. Use resultView: \"items\" | \"titles\" to choose individual entries or collapsed titles; titles groups all matching episodes from the same TV show, or issues from the same series, into one title result with a matching-item count.",
        "annotations": { "readOnlyHint": true, "destructiveHint": false }
      },
      {
        "name": "create_watchlists",
        "title": "Create watchlists",
        "description": "Create one or more watchlists. Each requested watchlist is processed independently and returns an ordered result.",
        "annotations": { "readOnlyHint": false, "destructiveHint": false }
      },
      {
        "name": "update_watchlists",
        "title": "Update watchlists",
        "description": "Update one or more watchlists. Each requested watchlist is processed independently and returns an ordered result. Omit a field to keep its existing value; use null or an empty string only to clear the description. Name cannot be cleared, and each update must include at least one field to update.",
        "annotations": { "readOnlyHint": false, "destructiveHint": false }
      },
      {
        "name": "reorder_watchlist_items",
        "title": "Reorder watchlist items",
        "description": "Reorder one or more watchlist items within a custom-ordered watchlist, moving each item before or after a reference item. Each reorder targets an explicit watchlist, moved item ID, reference item ID, and before-or-after position, is processed independently, and returns an ordered result. Only custom-ordered watchlists accept reorders. This changes the order of items and is consequential, so confirm before applying.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false
        }
      },
      {
        "name": "edit_watchlist_items",
        "title": "Edit watchlist item metadata",
        "description": "Edit the stored title, release date, and poster image of one or more watchlist items. Each edit targets a stable internal watchlist item ID and is processed independently, returning an ordered result. Omit a field to keep its existing value; use null only to clear release date or poster image. Title cannot be cleared. Each edit must include at least one field to update. Poster image must be an HTTPS URL or a provider path beginning with /. Release date must be YYYY or YYYY-MM-DD.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        }
      }
    ],
