    {
      "id": "find-watchlist-items-text-search-and-selector-errors",
      "description": "find_watchlist_items paginates text queries and rejects invalid selector combinations",
      "mutating": false,
      "steps": [
        {
          "tool": "find_watchlist_items",
          "arguments": { "watchlistId": 41, "query": "SHOW", "resultView": "titles" },
          "expect": { "kind": "ok", "hasCursor": false }
        },
        {
          "tool": "find_watchlist_items",
          "arguments": { "watchlistId": 41, "query": "SHOW", "pageSize": 1 },
