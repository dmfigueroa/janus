{
  "name": "janus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:lint-plugin": "vitest run tools/oxlint/ComponentRendering.test.tsx",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "migrate": "npx -y tsx --env-file=.env src/db/Migrate.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@internationalized/date": "3.12.2",
    "@tanstack/intent": "^0.0.23",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.167.5",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/dompurify": "^3.0.5",
    "better-sqlite3": "^12.6.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@latest",
    "p-limit": "^7.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^5.0.0",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "readdirp": "^5.0.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format:check && npm run typecheck && npm run test && npx lint-staged --concurrent 1"
  },
  "lint-staged": {
    "*.tsx": [
      "oxlint --fix --config tools/oxlint/StagedTsx.oxlintrc.json",
      "oxfmt --write"
    ],
    "*.{js,ts,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,html,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
